# AgriFleet environment template
#
# Netlify only builds and hosts the React/Vite frontend. The FastAPI,
# PostgreSQL, and WebSocket services must be hosted separately.

# Frontend variables used by Vite. Configure these in Netlify:
# Site settings -> Build & deploy -> Environment variables
VITE_API_BASE_URL=https://your-backend.example.com
VITE_WS_BASE_URL=wss://your-backend.example.com

# Optional frontend metadata
VITE_APP_NAME=AgriFleet
VITE_APP_ENV=production

# Backend variables for the FastAPI service host, not Netlify static hosting.
# Use these on Render, Railway, Fly.io, a VPS, or another backend platform.
DATABASE_URL=postgresql://agrifleet_user:change-me@localhost:5432/agrifleet
POSTGRES_DB=agrifleet
POSTGRES_USER=agrifleet_user
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_ORIGINS=https://your-netlify-site.netlify.app,http://localhost:5173

# Local development defaults
FRONTEND_PORT=5173
BACKEND_PORT=8000
